{
  "name": "@digitalproductpassport/solidity-sdk",
  "version": "2.0.0",
  "description": "SDK for interacting with the Digital Product Passport smart contracts using ethers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "hardhat test",
    "lint": "eslint .",
    "sync-contracts": "scripts/sync-contracts.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pinata/sdk": "^2.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22",
    "chai": "^6.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalProductPassport/web3-digital-product-passport-sdk.git"
  },
  "keywords": [
    "ethereum",
    "smart contracts",
    "Digital Product Passport",
    "sdk"
  ],
  "author": "Luthiano Trarbach",
  "license": "MIT"
}
